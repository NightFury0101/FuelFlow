{
  "name": "fuelflow",
  "version": "0.1.0",
  "private": true,
  "description": "FuelFlow \u2014 calorie counter and nutrition tracker with an AI nutrition coach. Eat Smarter. Track Better. Become Stronger.",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ios:prepare": "bash scripts/ios-prepare.sh",
    "ios:open": "npx cap open ios",
    "android:prepare": "bash scripts/android-prepare.sh",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^13.8.0 || ^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
